          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/techniques": {
      "get": {
        "tags": [
          "Policy"
        ],
        "summary": "Technique List",
        "operationId": "technique_list_api_techniques_get",
